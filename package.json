{
  "name": "pocketlist",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test server/*.test.ts src/lib/*.test.ts",
    "warm": "tsx server/warm.ts",
    "dev:warm": "POCKETLIST_WARM=1 concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "start": "tsx server/index.ts",
    "copy-to-postgres": "tsx server/copy-to-postgres.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@hono/node-server": "2.1.5",
    "@neon/config": "^1.12.0",
    "@neon/env": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "4.13.13",
    "lucide-react": "^0.454.0",
    "pg": "8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.20.4",
    "@types/pg": "8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "10.0.6",
    "railway": "^3.16.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
